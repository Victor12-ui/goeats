DATABASE_URL="mysql://root:@127.0.0.1:3309/goeats"
PORT=5000
JWT_SECRET="your-secret-key-here"
NODE_ENV="development"

# SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="user@example.com"
SMTP_PASS="your-password"
SMTP_FROM_NAME="GoEats"

# Google & Facebook OAuth (Opcional para validación estricta de Client ID / App ID en backend)
GOOGLE_CLIENT_ID="tu-client-id-de-google.apps.googleusercontent.com"
FACEBOOK_APP_ID="tu-app-id-de-facebook"
FACEBOOK_APP_SECRET="tu-app-secret-de-facebook"

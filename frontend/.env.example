# URL de la API del Backend (por defecto http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Google Identity Services (Client ID obtenido de Google Cloud Console)
# Ejemplo: 123456789012-abc123def456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Facebook Login (App ID obtenido de Meta for Developers)
# Ejemplo: 123456789012345
VITE_FACEBOOK_APP_ID=
